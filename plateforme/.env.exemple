# Copier en .env avant le premier demarrage.
POSTGRES_USER=rugby
POSTGRES_PASSWORD=rugby_dev
POSTGRES_DB=rugbystats

# Port de la base sur la machine hote, pour psql ou un
# client graphique. 5433 est souvent pris par un autre
# projet.
DB_PORT=5434

# Port de l'API sur la machine hote.
API_PORT=8080

# Port du front sur la machine hote.
WEB_PORT=5173
