#!/bin/sh
#
# Maintient l'export VBA a jour quand le classeur est commite.
#
# Le code VBA vit dans un flux binaire : sans cet export, git ne
# montre qu'un changement de taille de fichier. Le hook relance donc
# outils/export_vba.py des que "Createur de match.xlsm" fait partie
# du commit, et ajoute le resultat au commit en cours.
#
# Installation, une fois par clone :
#     git config core.hooksPath outils/hooks
#
# Pour passer outre ponctuellement :
#     git commit --no-verify

CLASSEUR="Createur de match.xlsm"

# Rien a faire si le classeur ne fait pas partie du commit.
if [ -z "$(git diff --cached --name-only -- "$CLASSEUR")" ]; then
    exit 0
fi

# L'environnement du projet est prefere au Python du systeme, que
# Homebrew protege contre les installations de paquets (PEP 668).
if [ -x ".venv/bin/python" ]; then
    PYTHON=".venv/bin/python"
else
    PYTHON="python3"
fi

if ! "$PYTHON" -c "import oletools" 2>/dev/null; then
    echo "pre-commit : oletools est necessaire pour exporter le VBA."
    echo "  python3 -m venv .venv"
    echo "  .venv/bin/pip install oletools"
    echo "  (ou git commit --no-verify pour passer outre)"
    exit 1
fi

if ! "$PYTHON" outils/export_vba.py "$CLASSEUR"; then
    echo "pre-commit : l'export du VBA a echoue, commit interrompu."
    exit 1
fi

# -A pour que les modules supprimes disparaissent aussi du commit.
git add -A vba

exit 0
