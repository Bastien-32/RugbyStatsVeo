# macOS
.DS_Store

# Environnements Python
.venv/
**/.venv/

# Python
__pycache__/
**/__pycache__/
*.pyc

# Fichiers générés par PyInstaller
**/build/
**/dist/

# Journaux et PID
*.log
*.pid

# Fichiers temporaires Excel
~$*.xls
~$*.xlsx
~$*.xlsm
# Reglages d'editeur propres a cette machine.
.vscode/
**/.vscode/

# Fichiers de match : données de production, jamais versionnées.
Matchs/*
# Marqueur garantissant que le dossier existe toujours.
!Matchs/.gitkeep

# Les installeurs des logiciels tiers ne sont pas versionnes :
# le dossier "logiciels à installer" ne porte que des liens.
logiciels à installer/*.dmg
logiciels à installer/*.exe
logiciels à installer/*.pkg
